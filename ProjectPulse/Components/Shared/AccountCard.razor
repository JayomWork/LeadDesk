<article class="account-workload-card @(NeedsAttention ? "attention" : null)">
    <div class="account-card-head">
        <div class="account-avatar">@Initial(Summary.Account.Name)</div>
        <div>
            <h2>@Summary.Account.Name</h2>
            <p>@ContactText</p>
        </div>
        <div class="account-badges">
            <span class="health-badge @(Summary.Account.IsActive ? "active" : "inactive")">@(Summary.Account.IsActive ? "Active" : "Inactive")</span>
            <span class="priority-badge @Summary.Priority.ToLowerInvariant()">@Summary.Priority</span>
        </div>
    </div>

    <div class="account-meta-grid">
        <span>Owner <strong>@Summary.OwnerName</strong></span>
        <span>Last updated <strong>@RelativeDate(Summary.LastUpdatedAt)</strong></span>
        <span>Next meeting <strong>@MeetingText</strong></span>
    </div>

    <div class="account-task-row">
        <span><small>Pending</small><strong>@Summary.PendingTasks</strong></span>
        <span><small>In Queue</small><strong>@Summary.InQueueTasks</strong></span>
        <span><small>Completed</small><strong>@Summary.DoneTasks</strong></span>
        <span class="@(Summary.OverdueTasks > 0 ? "overdue" : null)"><small>Overdue</small><strong>@Summary.OverdueTasks</strong></span>
    </div>

    <div class="account-progress-wrap">
        <div class="account-progress-ring" style="--progress:@ProgressPercent"><span>@ProgressPercent%</span></div>
        <div>
            <div class="account-progress-label"><strong>@ProgressPercent% progress</strong><span>@Summary.TotalTasks total task@(Summary.TotalTasks == 1 ? "" : "s")</span></div>
            <div class="account-progress"><span style="width:@ProgressPercent%"></span></div>
        </div>
    </div>

    <div class="account-card-actions">
        <a class="secondary-button small" href="accounts/@Summary.Account.Id">View Tasks</a>
        <a class="primary-button small" href="tasks/new?accountId=@Summary.Account.Id">+ Add Task</a>
        <a class="icon-button" title="Meeting notes" href="meetings/new?accountId=@Summary.Account.Id">M</a>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public AccountTaskSummary Summary { get; set; } = new();

    private bool NeedsAttention => Summary.OverdueTasks > 0 || Summary.PendingTasks >= 10 || Summary.Priority == "High";
    private int ProgressPercent => Summary.TotalTasks == 0 ? 0 : (int)Math.Round(Summary.DoneTasks * 100m / Summary.TotalTasks);
    private string MeetingText => Summary.NextMeetingDate?.ToString("dd MMM yyyy") ?? "Not scheduled";

    private string ContactText
    {
        get
        {
            var account = Summary.Account;
            if (!string.IsNullOrWhiteSpace(account.ClientContactName) && !string.IsNullOrWhiteSpace(account.ClientContactEmail)) return $"Client Contact: {account.ClientContactName}";
            if (!string.IsNullOrWhiteSpace(account.ClientContactName)) return $"Client Contact: {account.ClientContactName}";
            if (!string.IsNullOrWhiteSpace(account.ClientContactEmail)) return account.ClientContactEmail;
            return "No client contact";
        }
    }

    private static string Initial(string value) => string.IsNullOrWhiteSpace(value) ? "A" : value[..1].ToUpperInvariant();

    private static string RelativeDate(DateTime value)
    {
        var span = DateTime.UtcNow - value.ToUniversalTime();
        if (span.TotalMinutes < 2) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return value.ToLocalTime().ToString("dd MMM yyyy");
    }
}
