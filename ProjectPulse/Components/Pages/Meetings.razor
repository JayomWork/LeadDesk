@page "/meetings"
@attribute [Authorize]
@rendermode InteractiveServer
<PageTitle>Meetings · ProjectPulse</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Conversations to action</span><h1>Meetings</h1><p>Decisions, follow-ups and linked delivery work.</p></div><a class="primary-button" href="meetings/new">＋ New meeting</a></div>
<section class="surface"><div class="meeting-list">@foreach (var meeting in meetings) { <a class="meeting-row" href="meetings/@meeting.Id"><div class="date-tile"><strong>@meeting.MeetingDate.Day</strong><span>@meeting.MeetingDate.ToString("MMM")</span></div><div><span class="eyebrow">@meeting.MeetingType</span><h2>@meeting.Title</h2><p>@meeting.AccountPractice?.Name · @meeting.Attendees</p></div><span class="task-count">@meeting.MeetingWorkItems.Count task(s)</span></a> }</div></section>
@code { private List<Meeting> meetings = []; protected override async Task OnInitializedAsync() => meetings = await LeadDesk.GetMeetingsAsync(); }
