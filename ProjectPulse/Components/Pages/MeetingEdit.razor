@page "/meetings/new"
@page "/meetings/{Id:long}/edit"
@attribute [Authorize]
@rendermode InteractiveServer
<PageTitle>Meeting · ProjectPulse</PageTitle>
<div class="page-heading"><div><span class="eyebrow">Capture context</span><h1>@(Id == 0 ? "New meeting" : "Edit meeting")</h1></div></div>
<EditForm Model="model" OnValidSubmit="Save" FormName="meeting-form"><DataAnnotationsValidator /><ValidationSummary /><section class="surface form-surface"><div class="form-grid">
<div class="field span-2"><label>Title</label><InputText class="input" @bind-Value="model.Title" /></div><div class="field"><label>Type</label><InputSelect class="input" @bind-Value="model.MeetingType">@foreach (var x in LeadDeskOptions.MeetingTypes) { <option>@x</option> }</InputSelect></div><div class="field"><label>Account</label><InputSelect class="input" @bind-Value="model.AccountPracticeId"><option value="">No account</option>@foreach (var x in accounts) { <option value="@x.Id">@x.Name</option> }</InputSelect></div><div class="field"><label>Date and time</label><InputDate Type="InputDateType.DateTimeLocal" class="input" @bind-Value="model.MeetingDate" /></div><div class="field"><label>Attendees</label><InputText class="input" @bind-Value="model.Attendees" /></div><div class="field full"><label>Linked tasks</label><MultiSelect Options="taskOptions" @bind-Selected="model.SelectedWorkItemIds" Placeholder="Select tasks" SearchPlaceholder="Search tasks…" /></div><div class="field full"><label>Discussion summary</label><InputTextArea class="input textarea" @bind-Value="model.DiscussionSummary" /></div><div class="field full"><label>Decisions</label><InputTextArea class="input" @bind-Value="model.Decisions" /></div><div class="field full"><label>Next steps</label><InputTextArea class="input" @bind-Value="model.NextSteps" /></div><div class="field"><label>Next follow-up</label><InputDate class="input" @bind-Value="model.NextFollowUpDate" /></div></div><div class="form-actions"><button class="primary-button">Save meeting</button><a class="secondary-button" href="meetings">Cancel</a></div></section></EditForm>
@code { [Parameter] public long Id { get; set; } private Meeting model = new(); private List<AccountPractice> accounts = []; private List<LookupOption> taskOptions = []; protected override async Task OnParametersSetAsync() { accounts = await LeadDesk.GetAccountsAsync(); taskOptions = (await LeadDesk.GetTasksAsync(new TaskQuery())).Select(x => new LookupOption(x.Id, $"{x.Title} [{x.Status}]")).ToList(); model = Id == 0 ? new Meeting { MeetingDate = DateTime.Now } : await LeadDesk.GetMeetingAsync(Id) ?? new(); } private async Task Save() { var id = await LeadDesk.SaveMeetingAsync(model); Navigation.NavigateTo($"meetings/{id}"); } }
