@page "/tasks/{Id:long}"
@attribute [Authorize]
@rendermode InteractiveServer
<PageTitle>Task details - ProjectPulse</PageTitle>

@if (item == null)
{
    <div class="loading"><span class="loader"></span>Loading task...</div>
}
else
{
    <div class="page-heading">
        <div>
            <span class="eyebrow">@item.Type - @item.ModuleName</span>
            <h1>@item.Title</h1>
            <div class="inline-meta"><span class="priority priority-@Key(item.Priority)">@item.Priority</span><span class="status-label status-@Key(item.Status)">@item.Status</span><span>Due @DueDateText</span>@if (PlannedRelease is { } release) { <span class="release-chip">@release</span> }</div>
        </div>
        <div class="page-heading-actions">
            <a class="secondary-button" href="tasks">Back to Tasks</a>
            <ImportantTaskButton TaskId="item.Id" IsImportant="item.IsImportant" IsImportantChanged="value => item.IsImportant = value" />
            <a class="secondary-button" href="tasks/@Id/edit">Edit task</a>
        </div>
    </div>
    <div class="detail-grid">
        <section class="surface">
            <h2>Brief</h2>
            <p class="preline">@(item.Description ?? "No description added.")</p>
            <h3>Latest update</h3>
            <p class="preline">@(item.LatestUpdate ?? "No update yet.")</p>
            @if (!string.IsNullOrWhiteSpace(item.BlockerReason)) { <div class="alert-card"><strong>Blocker</strong><p>@item.BlockerReason</p></div> }
        </section>
        <aside class="surface">
            <h2>Ownership</h2>
            <dl class="detail-list">
                <dt>Accounts</dt><dd>@AccountNames</dd>
                <dt>Developers</dt><dd>@DeveloperNames</dd>
                <dt>QA</dt><dd>@(item.AssignedQa?.FullName ?? "Unassigned")</dd>
                <dt>Owner</dt><dd>@(item.Owner?.FullName ?? "Unassigned")</dd>
                <dt>Release</dt><dd>@(item.ReleaseVersion ?? PlannedRelease ?? "Not planned")</dd>
            </dl>
        </aside>
    </div>
    <section class="surface">
        <div class="section-head"><h2>Activity</h2></div>
        <div class="timeline">
            @foreach (var update in item.Updates.OrderByDescending(x => x.CreatedAt))
            {
                <div><i></i><strong>@update.NewStatus</strong><span>@update.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span><p>@update.UpdateText</p></div>
            }
        </div>
    </section>
}

@code {
    [Parameter] public long Id { get; set; }
    private WorkItem? item;

    private string DueDateText => item?.DueDate?.ToString("dd MMM yyyy") ?? "Not set";
    private string AccountNames => item == null ? "" : Names(item.WorkItemAccounts.Select(x => x.AccountPractice.Name), item.AccountPractice?.Name, "All accounts");
    private string DeveloperNames => item == null ? "" : Names(item.WorkItemDevelopers.Select(x => x.TeamMember.FullName), item.AssignedDeveloper?.FullName, "Backlog");
    private string? PlannedRelease => item?.ReleaseWorkItems
        .Where(x => x.ReleasePlan.Status is not "Released" and not "Completed" and not "Cancelled")
        .OrderBy(x => x.ReleasePlan.ReleaseDate ?? DateTime.MaxValue)
        .Select(x => $"{x.ReleasePlan.Version}{(x.ReleasePlan.ReleaseDate.HasValue ? $" - {x.ReleasePlan.ReleaseDate.Value:dd MMM}" : string.Empty)}")
        .FirstOrDefault();

    protected override async Task OnParametersSetAsync() => item = await LeadDesk.GetTaskAsync(Id);
    private static string Key(string value) => value.ToLowerInvariant().Replace(" ", "-");

    private static string Names(IEnumerable<string?> linkedNames, string? fallbackName, string defaultText)
    {
        var names = linkedNames.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!).ToList();
        if (names.Count == 0 && !string.IsNullOrWhiteSpace(fallbackName)) names.Add(fallbackName);
        return names.Count == 0 ? defaultText : string.Join(", ", names);
    }
}
