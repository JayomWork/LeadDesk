@page "/tasks"
@attribute [Authorize]
@rendermode InteractiveServer
<PageTitle>Tasks - ProjectPulse</PageTitle>

<div class="page-heading">
    <div><span class="eyebrow">Delivery board</span><h1>Tasks</h1><p>Plan, assign and move work without leaving the list.</p></div>
    <div class="page-heading-actions">
        <div class="view-switch" aria-label="Task view">
            <button type="button" class="@(viewMode == "List" ? "active" : null)" @onclick='() => viewMode = "List"'>☷ List</button>
            <button type="button" class="@(viewMode == "Board" ? "active" : null)" @onclick='() => viewMode = "Board"'>▦ Board</button>
        </div>
        <a class="primary-button" href="tasks/new">+ New task</a>
    </div>
</div>

<section class="surface filter-surface">
    <div class="filter-grid">
        <input class="input" placeholder="Search tasks, updates..." @bind="query.Search" @bind:event="oninput" />
        <select class="input select-input" @bind="query.AccountId"><option value="">All accounts</option>@foreach (var x in accounts) { <option value="@x.Id">@x.Name</option> }</select>
        <select class="input select-input" @bind="query.DeveloperId"><option value="">All developers</option>@foreach (var x in team) { <option value="@x.Id">@x.FullName</option> }</select>
        <select class="input select-input" @bind="query.Status"><option value="">All statuses</option>@foreach (var x in LeadDeskOptions.Statuses) { <option>@x</option> }</select>
        <select class="input select-input" @bind="query.Priority"><option value="">All priorities</option>@foreach (var x in LeadDeskOptions.Priorities) { <option>@x</option> }</select>
        <select class="input select-input" @bind="query.SortBy"><option value="Workflow">Workflow order</option><option>Newest</option><option>Oldest</option><option>Priority</option><option>Title</option></select>
        <label class="check"><input type="checkbox" @bind="query.IncludeArchived" /> Include archived</label>
        <button class="secondary-button" @onclick="Load" disabled="@isLoading">@(isLoading ? "Loading..." : "Apply filters")</button>
    </div>
</section>

@if (viewMode == "Board")
{
    <div class="board-toolbar">
        <div>
            <span class="eyebrow">Group board by</span>
            <div class="segmented-control">
                <button type="button" class="@(boardGroup == "Status" ? "active" : null)" @onclick='() => boardGroup = "Status"'>Task status</button>
                <button type="button" class="@(boardGroup == "Person" ? "active" : null)" @onclick='() => boardGroup = "Person"'>Person</button>
            </div>
        </div>
        <p>Drag a card to another column to update it automatically.</p>
    </div>
}

<section class="surface @(viewMode == "Board" ? "board-surface" : null)">
    @if (isLoading)
    {
        <div class="loading"><span class="loader"></span>Loading tasks...</div>
    }
    else
    {
        @if (viewMode == "Board")
        {
            <TaskBoard Items="items" Team="team" GroupBy="@boardGroup" OnStatusChanged="ChangeStatus" OnAssigneeChanged="ChangeAssignee" OnTaskCreated="CreateBoardTask" OnTaskEdited="EditBoardTask" />
        }
        else
        {
            <TaskTable Items="items" OnStatusChanged="ChangeStatus" />
        }
    }
</section>

@code {
    private readonly TaskQuery query = new();
    private List<WorkItem> items = [];
    private List<AccountPractice> accounts = [];
    private List<TeamMember> team = [];
    private bool isLoading = true;
    private string viewMode = "Board";
    private string boardGroup = "Status";

    protected override async Task OnInitializedAsync()
    {
        var accountsTask = LeadDesk.GetAccountsAsync();
        var teamTask = LeadDesk.GetTeamAsync(true);
        await Task.WhenAll(accountsTask, teamTask);
        accounts = await accountsTask;
        team = await teamTask;
        await Load();
    }

    private async Task Load()
    {
        isLoading = true;
        items = await LeadDesk.GetTasksAsync(query);
        isLoading = false;
    }

    private async Task ChangeStatus((WorkItem Item, string Status) change)
    {
        var oldStatus = change.Item.Status;
        change.Item.Status = change.Status;
        StateHasChanged();
        try
        {
            await LeadDesk.UpdateTaskStatusAsync(change.Item.Id, change.Status);
        }
        catch
        {
            change.Item.Status = oldStatus;
            StateHasChanged();
            throw;
        }
    }

    private async Task ChangeAssignee((WorkItem Item, long? TeamMemberId) change)
    {
        var oldAssignedId = change.Item.AssignedDeveloperId;
        var oldAssigned = change.Item.AssignedDeveloper;
        var oldLinks = change.Item.WorkItemDevelopers.ToList();
        ApplyAssignee(change.Item, change.TeamMemberId);
        StateHasChanged();
        try
        {
            await LeadDesk.UpdateTaskAssigneeAsync(change.Item.Id, change.TeamMemberId);
        }
        catch
        {
            change.Item.AssignedDeveloperId = oldAssignedId;
            change.Item.AssignedDeveloper = oldAssigned;
            change.Item.WorkItemDevelopers = oldLinks;
            StateHasChanged();
            throw;
        }
    }

    private async Task CreateBoardTask(WorkItem item)
    {
        ApplyAssignee(item, item.AssignedDeveloperId);
        var id = await LeadDesk.SaveTaskAsync(item);
        item.Id = id;
        items.Insert(0, item);
    }

    private async Task EditBoardTask(BoardTaskUpdate update)
    {
        await LeadDesk.UpdateBoardTaskAsync(update);
        var item = items.First(x => x.Id == update.Id);
        item.Title = update.Title.Trim();
        item.Status = update.Status;
        item.Priority = update.Priority;
        item.DueDate = update.DueDate;
        ApplyAssignee(item, update.TeamMemberId);
    }

    private void ApplyAssignee(WorkItem item, long? teamMemberId)
    {
        var member = team.FirstOrDefault(x => x.Id == teamMemberId);
        item.AssignedDeveloperId = member?.Id;
        item.AssignedDeveloper = member;
        item.WorkItemDevelopers = member == null
            ? []
            : [new WorkItemDeveloper { WorkItemId = item.Id, TeamMemberId = member.Id, TeamMember = member, WorkItem = item }];
    }
}
