@page "/reports/{Mode}"
@attribute [Authorize]
@rendermode InteractiveServer
<PageTitle>Reports - ProjectPulse</PageTitle>

<div class="page-heading">
    <div><span class="eyebrow">Operational clarity</span><h1>@Title</h1><p>@Subtitle</p></div>
    @if (Mode == "standup") { <button class="secondary-button print-button" onclick="window.print()">Print standup</button> }
</div>

@if (Mode == "accounts")
{
    <section class="surface filter-surface">
        <select class="input select-input search-input" @bind="accountId" @bind:after="Load">
            <option value="">All accounts</option>
            @foreach (var account in accounts) { <option value="@account.Id">@account.Name</option> }
        </select>
    </section>
}

@if (isLoading)
{
    <section class="surface"><div class="loading"><span class="loader"></span>Loading report...</div></section>
}
else if (Mode == "standup")
{
    @foreach (var group in StandupGroups)
    {
        <section class="surface standup-group">
            <div class="standup-member">
                <span class="large-avatar">@Initial(group.Name)</span>
                <div><span class="eyebrow">@(group.MemberId.HasValue ? "Team member" : "Unassigned")</span><h2>@group.Name</h2></div>
                <a class="secondary-button small" href="@AddTaskLink(group)">+ Task</a>
                <span class="standup-count">@group.Items.Count task@(group.Items.Count == 1 ? "" : "s")</span>
            </div>
            <TaskTable Items="group.Items" OnStatusChanged="ChangeStatus" />
        </section>
    }
}
else
{
    <section class="surface"><TaskTable Items="items" OnStatusChanged="ChangeStatus" /></section>
}

@code {
    [Parameter] public string Mode { get; set; } = "standup";
    private long? accountId;
    private List<AccountPractice> accounts = [];
    private List<WorkItem> items = [];
    private bool isLoading = true;

    private string Title => Mode switch { "accounts" => "Account progress", "manager" => "Manager summary", _ => "Daily standup" };
    private string Subtitle => Mode switch { "accounts" => "Review delivery by client account.", "manager" => "A clean view of active delivery and risk.", _ => "Active work grouped by each assigned team member." };

    private IEnumerable<StandupGroup> StandupGroups => items
        .SelectMany(item => DeveloperGroups(item).Select(member => new { Member = member, Item = item }))
        .GroupBy(x => new { x.Member.Id, x.Member.Name })
        .OrderBy(x => x.Key.Id.HasValue ? 0 : 1)
        .ThenBy(x => x.Key.Name)
        .Select(group => new StandupGroup(group.Key.Id, group.Key.Name, group.Select(x => x.Item).DistinctBy(x => x.Id).ToList()));

    protected override async Task OnParametersSetAsync()
    {
        accounts = await LeadDesk.GetAccountsAsync();
        await Load();
    }

    private async Task Load()
    {
        isLoading = true;
        var query = new TaskQuery
        {
            AccountId = Mode == "accounts" ? accountId : null,
            IncludeArchived = Mode == "accounts",
            SortBy = Mode == "manager" ? "Priority" : "Workflow"
        };
        items = await LeadDesk.GetTasksAsync(query);
        isLoading = false;
    }

    private async Task ChangeStatus((WorkItem Item, string Status) change)
    {
        await LeadDesk.UpdateTaskStatusAsync(change.Item.Id, change.Status);
        await Load();
    }

    private static IEnumerable<StandupMember> DeveloperGroups(WorkItem item)
    {
        var members = item.WorkItemDevelopers
            .Select(x => new StandupMember(x.TeamMemberId, x.TeamMember.FullName))
            .Where(x => !string.IsNullOrWhiteSpace(x.Name))
            .Distinct()
            .ToList();
        if (members.Count == 0 && item.AssignedDeveloper != null) members.Add(new StandupMember(item.AssignedDeveloper.Id, item.AssignedDeveloper.FullName));
        return members.Count == 0 ? [new StandupMember(null, "Backlog")] : members;
    }

    private static string AddTaskLink(StandupGroup group) => group.MemberId.HasValue ? $"tasks/new?developerId={group.MemberId}" : "tasks/new";
    private static string Initial(string name) => name == "Backlog" ? "B" : name[..1].ToUpperInvariant();
    private sealed record StandupMember(long? Id, string Name);
    private sealed record StandupGroup(long? MemberId, string Name, List<WorkItem> Items);
}
