@page "/releases"
@attribute [Authorize]
@rendermode InteractiveServer
<PageTitle>Releases - ProjectPulse</PageTitle>

<div class="page-heading">
    <div><span class="eyebrow">Release planning</span><h1>Releases</h1><p>Select QA-done and release-ready tasks into a sprint or planned release.</p></div>
</div>

@if (isLoading)
{
    <section class="surface"><div class="loading"><span class="loader"></span>Loading release workspace...</div></section>
}
else
{
    <EditForm Model="model" OnValidSubmit="Save" FormName="release-form">
        <DataAnnotationsValidator />
        <ValidationSummary />
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="form-error">@errorMessage</div>
        }

        <section class="surface form-surface wide-form">
            <div class="section-head">
                <div><span class="eyebrow">Plan release</span><h2>New sprint / release</h2></div>
                <button class="secondary-button small" type="button" @onclick="SelectCandidates">Select candidates</button>
            </div>
            <div class="form-grid">
                <div class="field"><label>Version / sprint</label><InputText class="input" required @bind-Value="model.Version" /></div>
                <div class="field"><label>Planned release date</label><InputDate class="input" @bind-Value="model.ReleaseDate" /></div>
                <div class="field"><label>Status</label><InputSelect class="input select-input" @bind-Value="model.Status">@foreach (var status in LeadDeskOptions.ReleaseStatuses) { <option>@status</option> }</InputSelect></div>
                <label class="check field"><InputCheckbox @bind-Value="model.QaSignedOff" /> QA signed off</label>
                <label class="check field"><InputCheckbox @bind-Value="model.ClientSignedOff" /> Client signed off</label>
                <div class="field full"><label>Tasks</label><MultiSelect Options="candidateOptions" @bind-Selected="model.SelectedWorkItemIds" Placeholder="Select release tasks" SearchPlaceholder="Search release tasks..." /></div>
                <div class="field full"><label>Release notes</label><InputTextArea class="input textarea" @bind-Value="model.ReleaseNotes" /></div>
            </div>
            <div class="form-actions"><button class="primary-button" type="submit" disabled="@isSaving">@(isSaving ? "Saving..." : "Create release")</button></div>
        </section>
    </EditForm>

    <section class="surface">
        <div class="section-head"><div><span class="eyebrow">Auto populated</span><h2>Release candidate tasks</h2></div><span class="task-count">@candidateTasks.Count task@(candidateTasks.Count == 1 ? "" : "s")</span></div>
        <TaskTable Items="candidateTasks" OnStatusChanged="ChangeStatus" />
    </section>

    <section class="surface">
        <div class="section-head"><div><span class="eyebrow">History</span><h2>Release plans</h2></div></div>
        @if (releasePlans.Count == 0)
        {
            <EmptyState Title="No releases yet" Message="Create your first release plan above." />
        }
        else
        {
            <div class="release-list">
                @foreach (var release in releasePlans)
                {
                    <article class="release-card @(release.Status == "Released" ? "released" : null)">
                        <div class="release-main">
                            <div>
                                <span class="status-label">@release.Status</span>
                                <h2>@release.Version</h2>
                                <p>@(release.ReleaseDate?.ToString("dd MMM yyyy") ?? "No release date")</p>
                            </div>
                            <div class="release-actions">
                                @if (release.QaSignedOff) { <span class="status-label signed">QA signed</span> }
                                @if (release.ClientSignedOff) { <span class="status-label signed">Client signed</span> }
                            </div>
                        </div>
                        @if (release.ReleaseWorkItems.Count > 0)
                        {
                            <div class="release-tasks">
                                @foreach (var link in release.ReleaseWorkItems.OrderBy(x => x.WorkItem.Title))
                                {
                                    <a href="tasks/@link.WorkItemId">@link.WorkItem.Title <span>@link.WorkItem.Status</span></a>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>
}

@code {
    private ReleasePlan model = NewReleasePlan();
    private List<ReleasePlan> releasePlans = [];
    private List<WorkItem> candidateTasks = [];
    private List<LookupOption> candidateOptions = [];
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        isLoading = true;
        releasePlans = await LeadDesk.GetReleasePlansAsync();
        candidateTasks = await LeadDesk.GetReleaseCandidateTasksAsync();
        candidateOptions = candidateTasks.Select(x => new LookupOption(x.Id, $"{x.Title} [{x.Status}]")).ToList();
        if (model.Id == 0 && model.SelectedWorkItemIds.Count == 0) SelectCandidates();
        isLoading = false;
    }

    private void SelectCandidates() => model.SelectedWorkItemIds = candidateTasks.Select(x => x.Id).ToList();

    private async Task Save()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            await LeadDesk.SaveReleasePlanAsync(model);
            model = NewReleasePlan();
            await Load();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ChangeStatus((WorkItem Item, string Status) change)
    {
        await LeadDesk.UpdateTaskStatusAsync(change.Item.Id, change.Status);
        model.SelectedWorkItemIds = [];
        await Load();
    }

    private static ReleasePlan NewReleasePlan() => new()
    {
        Version = $"Sprint {DateTime.Today:yyyy-MM-dd}",
        Status = "Planned",
        ReleaseDate = DateTime.Today
    };
}
