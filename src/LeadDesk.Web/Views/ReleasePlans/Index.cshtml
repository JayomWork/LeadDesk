@model IEnumerable<ReleasePlan>
@{ ViewData["Title"] = "Release Queue"; ViewData["PageTitle"] = "Release Queue"; }
<div class="panel">
<div class="panel-header"><h2><i class="bi bi-rocket-takeoff me-2"></i>Release Plans</h2><a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i>New Release</a></div>
<div class="table-responsive"><table class="table align-middle">
<thead><tr><th>Version</th><th>Status</th><th>Release Date</th><th>Tasks</th><th>Signoff</th><th class="text-end">Actions</th></tr></thead>
<tbody>
@foreach (var release in Model)
{
    <tr class="@(release.Status == "Released" ? "release-plan-released" : "")">
        <td class="fw-semibold">@release.Version</td>
        <td><span class="badge status-badge status-@(release.Status.ToLowerInvariant().Replace(" ", "-"))">@release.Status</span></td>
        <td>@release.ReleaseDate?.ToString("dd MMM yyyy")</td>
        <td>@foreach (var link in release.ReleaseWorkItems) { <div><a asp-controller="WorkItems" asp-action="Details" asp-route-id="@link.WorkItemId">@link.WorkItem.Title</a> <span class="small text-muted">(@link.WorkItem.Status)</span></div> }</td>
        <td><span title="QA signoff">QA: @(release.QaSignedOff ? "Yes" : "No")</span><br /><span title="Client signoff">Client: @(release.ClientSignedOff ? "Yes" : "No")</span></td>
        <td><div class="d-flex justify-content-end gap-1"><a asp-action="Edit" asp-route-id="@release.Id" class="btn btn-light btn-sm"><i class="bi bi-pencil"></i>Edit</a>@if (release.Status != "Released") { <form asp-action="MarkReleased" asp-route-id="@release.Id" method="post" onsubmit="return confirm('Mark this release and all selected tasks as released?');"><button class="btn btn-success btn-sm"><i class="bi bi-check2-circle"></i>Release</button></form> }</div></td>
    </tr>
}
</tbody></table></div>
</div>
