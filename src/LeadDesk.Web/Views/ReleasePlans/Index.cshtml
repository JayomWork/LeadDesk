@model IEnumerable<ReleasePlan>
@{ ViewData["Title"] = "Release Queue"; ViewData["PageTitle"] = "Release Queue"; }
<div class="panel"><div class="panel-header"><h2><i class="bi bi-rocket-takeoff me-2"></i>Release Plans</h2><a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i>New Release</a></div><table class="table"><thead><tr><th>Version</th><th>Status</th><th>Release Date</th><th>QA Signoff</th><th>Client Signoff</th></tr></thead><tbody>@foreach(var x in Model){<tr><td class="fw-semibold">@x.Version</td><td><span class="badge status-badge">@x.Status</span></td><td>@x.ReleaseDate?.ToString("dd MMM yyyy")</td><td>@x.QaSignedOff</td><td>@x.ClientSignedOff</td></tr>}</tbody></table></div>
