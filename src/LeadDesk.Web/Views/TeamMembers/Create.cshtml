@model TeamMember
@{ ViewData["Title"] = "Add Team Member"; ViewData["PageTitle"] = "Add Team Member"; }
<div class="panel form-panel"><form method="post"><div class="row g-3"><div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /></div><div class="col-md-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select"><option>Project Lead</option><option>Manager</option><option>Developer</option><option>Sr. Developer</option><option>QA</option><option>Client</option></select></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /></div><div class="col-12"><button class="btn btn-primary">Save</button></div></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
