@model IEnumerable<Meeting>
@{ ViewData["Title"] = "Meetings"; ViewData["PageTitle"] = "Meetings / Call Logs"; }
<div class="panel"><div class="panel-header"><h2><i class="bi bi-camera-video me-2"></i>Meetings</h2><a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i>New Meeting</a></div><table class="table"><thead><tr><th>Date</th><th>Title</th><th>Type</th><th>Account</th><th>Next Follow-up</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.MeetingDate.ToString("dd MMM yyyy")</td><td><a asp-action="Details" asp-route-id="@x.Id" class="fw-semibold">@x.Title</a></td><td><span class="badge status-badge">@x.MeetingType</span></td><td>@x.AccountPractice?.Name</td><td>@x.NextFollowUpDate?.ToString("dd MMM yyyy")</td></tr>}</tbody></table></div>
