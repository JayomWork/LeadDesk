@model Meeting
@{ ViewData["Title"] = "New Meeting"; ViewData["PageTitle"] = "New Meeting"; var workItems = ViewBag.WorkItems as List<WorkItem> ?? new(); }
<div class="panel form-panel"><form method="post"><div class="row g-3"><div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div><div class="col-md-4"><label asp-for="MeetingDate" class="form-label"></label><input asp-for="MeetingDate" type="datetime-local" class="form-control" /></div><div class="col-md-4"><label asp-for="MeetingType" class="form-label"></label><select asp-for="MeetingType" asp-items="ViewBag.MeetingTypes" class="form-select"></select></div><div class="col-md-4"><label asp-for="AccountPracticeId" class="form-label">Account</label><select asp-for="AccountPracticeId" asp-items="ViewBag.Accounts" class="form-select"><option value="">No Account</option></select></div><div class="col-md-4"><label asp-for="NextFollowUpDate" class="form-label"></label><input asp-for="NextFollowUpDate" type="date" class="form-control" /></div><div class="col-12"><label asp-for="Attendees" class="form-label"></label><input asp-for="Attendees" class="form-control" /></div><div class="col-12"><label asp-for="DiscussionSummary" class="form-label"></label><textarea asp-for="DiscussionSummary" rows="4" class="form-control"></textarea></div><div class="col-12"><label asp-for="Decisions" class="form-label"></label><textarea asp-for="Decisions" rows="3" class="form-control"></textarea></div><div class="col-12"><label asp-for="NextSteps" class="form-label"></label><textarea asp-for="NextSteps" rows="3" class="form-control"></textarea></div><div class="col-12"><label class="form-label">Link Existing Tasks</label><select name="selectedWorkItemIds" class="form-select" multiple size="8">@foreach(var item in workItems){<option value="@item.Id">@item.Title (@item.Status)</option>}</select></div><div class="col-12"><button class="btn btn-primary">Save Meeting</button></div></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
