@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ProjectPulse</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (SignInManager.IsSignedIn(User))
{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var userName = User.Identity?.Name ?? "User";
    var initial = userName.Length > 0 ? userName.Substring(0, 1).ToUpperInvariant() : "U";
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">
                <span class="brand-mark"><i class="bi bi-kanban"></i></span>
                <span>ProjectPulse</span>
            </div>
            <div class="profile-chip">
                <span class="avatar">@initial</span>
                <span>
                    <strong>@userName</strong>
                    <small>Practice Workspace</small>
                </span>
            </div>
            <nav class="sidebar-nav">
                <a asp-controller="Dashboard" asp-action="Index" class="@(currentController == "Dashboard" ? "active" : "")"><i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span></a>
                <a asp-controller="Accounts" asp-action="Index" class="@(currentController == "Accounts" ? "active" : "")"><i class="bi bi-building"></i><span>Accounts</span></a>
                <a asp-controller="WorkItems" asp-action="Index" class="@(currentController == "WorkItems" ? "active" : "")"><i class="bi bi-check2-square"></i><span>Tasks</span></a>
                <a asp-controller="Meetings" asp-action="Index" class="@(currentController == "Meetings" ? "active" : "")"><i class="bi bi-camera-video"></i><span>Meetings</span></a>
                <a asp-controller="Reports" asp-action="Standup" class="@(currentController == "Reports" && currentAction == "Standup" ? "active" : "")"><i class="bi bi-megaphone"></i><span>Standup</span></a>
                <a asp-controller="Reports" asp-action="AccountProgress" class="@(currentController == "Reports" && currentAction == "AccountProgress" ? "active" : "")"><i class="bi bi-graph-up-arrow"></i><span>Account Progress</span></a>
                <a asp-controller="Reports" asp-action="ManagerSummary" class="@(currentController == "Reports" && currentAction == "ManagerSummary" ? "active" : "")"><i class="bi bi-clipboard-data"></i><span>Manager Summary</span></a>
                <a asp-controller="ReleasePlans" asp-action="Index" class="@(currentController == "ReleasePlans" ? "active" : "")"><i class="bi bi-rocket-takeoff"></i><span>Release Queue</span></a>
                <a asp-controller="TeamMembers" asp-action="Index" class="@(currentController == "TeamMembers" ? "active" : "")"><i class="bi bi-people"></i><span>Team</span></a>
            </nav>
            <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout">
                <button class="btn btn-sidebar"><i class="bi bi-box-arrow-right"></i><span>Logout</span></button>
            </form>
        </aside>
        <main class="content">
            <header class="topbar">
                <div>
                    <div class="eyebrow">ProjectPulse Workspace</div>
                    <h1>@ViewData["PageTitle"]</h1>
                </div>
                <form asp-controller="WorkItems" asp-action="Index" method="get" class="topbar-search">
                    <i class="bi bi-search"></i>
                    <input name="Search" class="form-control" placeholder="Search tasks, accounts, notes..." />
                </form>
                <div class="topbar-actions">
                    <a asp-controller="WorkItems" asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i><span>New Task</span></a>
                </div>
            </header>
            @RenderBody()
        </main>
    </div>
}
else
{
    <main class="auth-page">@RenderBody()</main>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
