@model AccountPractice
<div class="panel form-panel">
<form method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Uuid" />
    <input type="hidden" asp-for="CreatedAt" />
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="Status" class="form-label"></label><input asp-for="Status" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="GoLiveDate" class="form-label"></label><input asp-for="GoLiveDate" type="date" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="ClientContactName" class="form-label"></label><input asp-for="ClientContactName" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="ClientContactEmail" class="form-label"></label><input asp-for="ClientContactEmail" class="form-control" /></div>
        <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="4"></textarea></div>
        <div class="col-12"><button class="btn btn-primary">Save</button><a asp-action="Index" class="btn btn-light">Cancel</a></div>
    </div>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
