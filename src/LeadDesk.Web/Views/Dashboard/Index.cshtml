@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; ViewData["PageTitle"] = "Dashboard"; }
<div class="metric-grid">
    <div class="metric-card"><i class="bi bi-folder2-open"></i><span>Total Open</span><strong>@Model.TotalOpen</strong></div>
    <div class="metric-card"><i class="bi bi-code-slash"></i><span>In Development</span><strong>@Model.InDevelopment</strong></div>
    <div class="metric-card"><i class="bi bi-shield-check"></i><span>Ready for QA</span><strong>@Model.ReadyForQa</strong></div>
    <div class="metric-card danger"><i class="bi bi-exclamation-octagon"></i><span>Blocked</span><strong>@Model.Blocked</strong></div>
    <div class="metric-card"><i class="bi bi-calendar-week"></i><span>Due This Week</span><strong>@Model.DueThisWeek</strong></div>
    <div class="metric-card success"><i class="bi bi-rocket-takeoff"></i><span>Released This Month</span><strong>@Model.ReleasedThisMonth</strong></div>
</div>
<div class="row g-4 mt-1">
    <div class="col-lg-8">
        <div class="panel"><div class="panel-header"><h2><i class="bi bi-clock-history me-2"></i>Recent Work Items</h2><a asp-controller="WorkItems" asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i>New Task</a></div><partial name="_WorkItemTable" model="Model.RecentItems" /></div>
    </div>
    <div class="col-lg-4">
        <div class="panel"><div class="panel-header"><h2><i class="bi bi-exclamation-triangle me-2"></i>Blocked Items</h2></div>
        @foreach (var item in Model.BlockedItems)
        { <div class="mini-card"><a asp-controller="WorkItems" asp-action="Details" asp-route-id="@item.Id">@item.Title</a><div class="small text-muted">@item.BlockerReason</div></div> }
        </div>
    </div>
</div>
