@model WorkItem
@{ ViewData["Title"] = Model.Title; ViewData["PageTitle"] = "Task Details"; }
@functions {
    private static string BadgeKey(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? "unknown"
            : value.Trim().ToLowerInvariant().Replace(".", "").Replace(" ", "-");

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:0.#} KB";
        return $"{bytes / 1024d / 1024d:0.#} MB";
    }
}
<div class="panel">
    <div class="panel-header">
        <div>
            <h2>@Model.Title</h2>
            <div class="text-muted">@Model.AccountPractice?.Name / @Model.ModuleName / @Model.Type</div>
        </div>
        <div class="d-flex gap-2">
            @if (Model.Status != "Released" && Model.Status != "Cancelled")
            {
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post">
                    <button class="btn btn-success btn-sm" type="submit"><i class="bi bi-check2-circle"></i>Complete</button>
                </form>
            }
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil-square"></i>Edit</a>
            @if (User.IsInRole("Admin") || User.IsInRole("ProjectLead") || User.IsInRole("Manager"))
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this task? It will be hidden but kept in the database.');">
                    <button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash"></i>Delete</button>
                </form>
            }
        </div>
    </div>
    <div class="row g-3 my-2">
        <div class="col-md-3"><span class="label">Status</span><div class="badge status-badge status-@BadgeKey(Model.Status)">@Model.Status</div></div>
        <div class="col-md-3"><span class="label">Priority</span><div><span class="priority priority-pill priority-@BadgeKey(Model.Priority)">@Model.Priority</span></div></div>
        <div class="col-md-3"><span class="label">Developer</span><div>@Model.AssignedDeveloper?.FullName</div></div>
        <div class="col-md-3"><span class="label">QA</span><div>@Model.AssignedQa?.FullName</div></div>
    </div>
    <p>@Model.Description</p>
    @if (!string.IsNullOrWhiteSpace(Model.BlockerReason))
    {
        <div class="alert alert-warning"><strong>Blocker:</strong> @Model.BlockerReason</div>
    }
</div>
<div class="row g-4 mt-1">
    <div class="col-lg-5">
        <div class="panel">
            <h2>Add Update</h2>
            <form asp-action="AddUpdate" method="post">
                <input type="hidden" name="workItemId" value="@Model.Id" />
                <textarea name="updateText" rows="4" class="form-control mb-2" placeholder="Latest progress"></textarea>
                <select name="newStatus" class="form-select mb-2">
                    <option value="">Keep current status</option>
                    <option>Analysis</option>
                    <option>In Dev</option>
                    <option>Ready for QA</option>
                    <option>In QA</option>
                    <option>QA Failed</option>
                    <option>Ready for Release</option>
                    <option>Released</option>
                    <option>Blocked</option>
                </select>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="isInternalNote" value="true" checked />
                    <label class="form-check-label">Internal note</label>
                </div>
                <button class="btn btn-primary">Save Update</button>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="panel">
            <h2>Progress History</h2>
            @foreach (var u in Model.Updates.OrderByDescending(x => x.CreatedAt))
            {
                <div class="timeline-item">
                    <div class="small text-muted">@u.CreatedAt.ToString("dd MMM yyyy hh:mm tt") / @u.OldStatus -> @u.NewStatus</div>
                    <div>@u.UpdateText</div>
                </div>
            }
        </div>
    </div>
</div>
<div class="row g-4 mt-1">
    <div class="col-lg-5">
        <div class="panel">
            <h2><i class="bi bi-paperclip me-2"></i>Add Attachments</h2>
            <form asp-action="AddAttachment" method="post" enctype="multipart/form-data" class="mt-3">
                <input type="hidden" name="workItemId" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label">Files</label>
                    <input type="file" name="attachments" class="form-control" multiple />
                </div>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label">Type</label>
                        <select name="sourceType" class="form-select">
                            <option>Document</option>
                            <option>Email</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email Received</label>
                        <input type="datetime-local" name="emailReceivedAt" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email From</label>
                        <input name="emailFrom" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email Subject</label>
                        <input name="emailSubject" class="form-control" />
                    </div>
                </div>
                <button class="btn btn-primary mt-3"><i class="bi bi-upload"></i>Upload</button>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="panel">
            <div class="panel-header"><h2><i class="bi bi-folder2-open me-2"></i>Attachments</h2></div>
            @if (!Model.Attachments.Any())
            {
                <div class="text-muted">No attachments uploaded yet.</div>
            }
            else
            {
                <div class="attachment-list">
                    @foreach (var attachment in Model.Attachments.OrderByDescending(x => x.CreatedAt))
                    {
                        <div class="attachment-row">
                            <div class="attachment-icon"><i class="bi @(attachment.SourceType == "Email" ? "bi-envelope-paper" : "bi-file-earmark")"></i></div>
                            <div class="attachment-main">
                                <a asp-action="DownloadAttachment" asp-route-id="@attachment.Id" class="fw-semibold">@attachment.FileName</a>
                                <div class="small text-muted">@attachment.SourceType / @FormatBytes(attachment.FileSizeBytes) / @attachment.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</div>
                                @if (attachment.SourceType == "Email")
                                {
                                    <div class="small text-muted">@attachment.EmailFrom @(!string.IsNullOrWhiteSpace(attachment.EmailSubject) ? $" - {attachment.EmailSubject}" : "")</div>
                                }
                            </div>
                            <a asp-action="DownloadAttachment" asp-route-id="@attachment.Id" class="btn btn-light btn-sm"><i class="bi bi-download"></i>Open</a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
