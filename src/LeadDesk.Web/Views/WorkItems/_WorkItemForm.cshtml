@model WorkItem
<div class="panel form-panel">
<form method="post">
<input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Uuid" /><input type="hidden" asp-for="CreatedAt" />
<div class="row g-3">
    <div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="AccountPracticeId" class="form-label">Account</label><select asp-for="AccountPracticeId" asp-items="ViewBag.Accounts" class="form-select"><option value="">No Account</option></select></div>
    <div class="col-md-3"><label asp-for="ModuleName" class="form-label"></label><input asp-for="ModuleName" class="form-control" placeholder="Scheduler / Claims / Notes" /></div>
    <div class="col-md-3"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="ViewBag.Types" class="form-select"></select></div>
    <div class="col-md-3"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" asp-items="ViewBag.Priorities" class="form-select"></select></div>
    <div class="col-md-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="ViewBag.Statuses" class="form-select"></select></div>
    <div class="col-md-4"><label asp-for="AssignedDeveloperId" class="form-label">Developer</label><select asp-for="AssignedDeveloperId" asp-items="ViewBag.DeveloperMembers" class="form-select"><option value="">Unassigned</option></select></div>
    <div class="col-md-4"><label asp-for="AssignedQaId" class="form-label">QA</label><select asp-for="AssignedQaId" asp-items="ViewBag.QaMembers" class="form-select"><option value="">Unassigned</option></select></div>
    <div class="col-md-4"><label asp-for="OwnerId" class="form-label">Owner</label><select asp-for="OwnerId" asp-items="ViewBag.OwnerMembers" class="form-select"><option value="">Unassigned</option></select></div>
    <div class="col-md-4"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" type="date" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="ReleaseVersion" class="form-label"></label><input asp-for="ReleaseVersion" class="form-control" /></div>
    <div class="col-md-4 d-flex align-items-end"><div class="form-check"><input asp-for="IsClientVisible" class="form-check-input" /><label asp-for="IsClientVisible" class="form-check-label">Client visible</label></div></div>
    <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="5" class="form-control"></textarea></div>
    <div class="col-12"><label asp-for="LatestUpdate" class="form-label"></label><textarea asp-for="LatestUpdate" rows="3" class="form-control"></textarea></div>
    <div class="col-12"><label asp-for="BlockerReason" class="form-label"></label><textarea asp-for="BlockerReason" rows="2" class="form-control"></textarea></div>
    <div class="col-12"><button class="btn btn-primary">Save</button><a asp-action="Index" class="btn btn-light">Cancel</a></div>
</div>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
